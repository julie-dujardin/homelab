# Zero Trust > Settings: the team domain, as <team>.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# Zero Trust > Access controls > Applications > the private viewer's > Edit > Additional settings: Application Audience (AUD) Tag
ACCESS_AUD=
# openssl rand -hex 32; also AUTO_COLONY_UPLOAD_TOKEN in auto-colony's .env
INGEST_TOKEN=
